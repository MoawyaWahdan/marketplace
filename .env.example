# Application secret key
# Replace this with a secure random value
SECRET_KEY=change-me


# Database connection
# Docker Compose uses the PostgreSQL service name "db" as the host.
# Production (Render) should use the Neon PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://marketplace:marketplace@db:5432/marketplace

# Test database connection (used for automated tests)
DATABASE_TEST_URL=postgresql+psycopg://marketplace:marketplace@db:5432/marketplace_test


# AWS S3 configuration for image uploads
# Leave empty for local development if S3 is not being used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=