# Python virtual environments
# Dependencies are installed inside Docker from requirements.txt
.venv/
venv/
env/

# Environment files
# Secrets should not be copied into the Docker image
.env
.env.*
!.env.example

# Git files
# Git history is not needed inside the Docker image
.git/
.gitignore

# Python cache files
# Generated automatically by Python
__pycache__/
*.pyc
*.pyo

# Testing and type-checking cache
.pytest_cache/
.mypy_cache/

# Build artifacts
*.egg-info/
dist/
build/

# Local databases
# Do not copy experimental database files into the image
*.db
database.db
test.db

# IDE and editor files
.vscode/
.idea/

# OS generated files
.DS_Store

# Documentation (not needed to run the application)
README.md

# Docker configuration files
# The image does not need these files copied inside itself
Dockerfile
docker-compose*.yml